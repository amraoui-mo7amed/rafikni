# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database (PostgreSQL)
DB_NAME=rafikni
DB_USER=rafikni
DB_PASSWORD=rafikni_pass
DB_HOST=db
DB_PORT=5432

# Redis (for real-time notifications)
REDIS_HOST=redis
REDIS_PORT=6379

# Google Gemini AI (free tier - get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Email (SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
